{
  "name": "@nwt/icons",
  "version": "1.3.1",
  "private": true,
  "description": "SVG icons organized by category and visual style",
  "files": [
    "icons",
    "react",
    "manifest.json",
    "categories.json",
    "palette.json",
    "variant-audit.json"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "exports": {
    "./react": {
      "types": "./react/index.d.ts",
      "default": "./react/index.js"
    },
    "./*": "./*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickjavos/nwt-icons.git"
  }
}
